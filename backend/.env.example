PORT=5000
NODE_ENV=development

# MySQL Database Configuration (Auto-falls back to embedded SQLite if unavailable)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=campus_bloodconnect
DB_PORT=3306

# Application JWT Secret
JWT_SECRET=super_secret_campus_bloodconnect_jwt_token_key_2026_xyz

# Google API & Real-Time Email Service (Gmail / Google Workspace)
GOOGLE_EMAIL_USER=your_gmail@gmail.com
GOOGLE_EMAIL_APP_PASSWORD=your_google_app_password
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# SMS Gateway Configuration (FAST2SMS / TWILIO / 2FACTOR / REAL-TIME GATEWAY)
SMS_PROVIDER=FAST2SMS
SMS_API_KEY=your_sms_gateway_api_key
FAST2SMS_API_KEY=your_fast2sms_api_key
SMS_SENDER_ID=CMPBLD

# Twilio (Optional international SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

CLIENT_URL=http://localhost:5173

