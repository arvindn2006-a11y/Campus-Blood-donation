PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=campus_bloodconnect
DB_PORT=3306

# Application JWT Secret
JWT_SECRET=super_secret_campus_bloodconnect_jwt_token_key_2026_xyz

# Firebase Admin SDK Credentials (Optional for local token decoding fallback, required for live Firebase token verification)
FIREBASE_PROJECT_ID=campus-bloodconnect
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@campus-bloodconnect.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# SMS Gateway Configuration
# Supported providers: DEV_LOG, FAST2SMS, TWILIO
SMS_PROVIDER=DEV_LOG
SMS_API_KEY=
SMS_SENDER_ID=CMPBLD
SMS_TEMPLATE_ID=

CLIENT_URL=http://localhost:5173
